{
  "name": "day-lanches-print-agent",
  "version": "1.0.0",
  "description": "Day Lanches Print Agent — Impressão automática de comandas",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Day Lanches",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "7.0.0"
  },
  "build": {
    "appId": "com.daylanches.printagent",
    "productName": "Day Lanches Print Agent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/icons/day-lanches-gestao-512.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "../assets/icons/day-lanches-gestao-512.png",
      "uninstallerIcon": "../assets/icons/day-lanches-gestao-512.png",
      "shortcutName": "Day Lanches Print Agent"
    }
  }
}
