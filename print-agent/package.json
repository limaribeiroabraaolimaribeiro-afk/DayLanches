{
  "name": "day-lanches-agent",
  "version": "2.0.0",
  "description": "Day Lanches Agent — Impressao e WhatsApp automatico",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Day Lanches",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "auto-launch": "^5.0.6",
    "electron-store": "7.0.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.daylanches.agent",
    "productName": "Day Lanches Agent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Day Lanches Agent"
    },
    "asarUnpack": [
      "node_modules/@whiskeysockets/**"
    ]
  }
}
