# ╔══════════════════════════════════════════════════════════╗
# ║  Day Lanches — Evolution API — Variáveis de ambiente   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env real no repositório.
# Use senhas fortes — gere com:  openssl rand -base64 32

# ── Domínio ──
# Subdomínio que aponta para esta VPS (registro DNS tipo A)
DOMAIN=evolution.daylanches.com.br

# ── Evolution API ──
EVOLUTION_API_PORT=8080
# Chave de autenticação da API — troque por uma chave longa e aleatória
EVOLUTION_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE_openssl_rand_base64_32

# ── PostgreSQL ──
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── Redis ──
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── Instância WhatsApp ──
# Nome da instância que será criada na Evolution API
INSTANCE_NAME=daylanches

# ── Fuso horário ──
TZ=America/Sao_Paulo

# ── WhatsApp Agent (whatsapp-agent/, processo PM2 fora do Docker) ──
# Usado apenas pelo script scripts/set-webhook.sh para registrar o webhook.
# Deve bater com PORT no whatsapp-agent/.env.
WHATSAPP_AGENT_PORT=3001
