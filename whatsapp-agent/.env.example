# ╔══════════════════════════════════════════════════════════╗
# ║  Day Lanches — WhatsApp Agent (VPS) — Variaveis de ambiente ║
# ╚══════════════════════════════════════════════════════════╝
#
# Copie para .env e preencha:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env real no repositorio.

# ── Servidor HTTP do agente ──
# Porta onde este processo escuta o webhook da Evolution API.
# Precisa bater com a URL configurada em infra/evolution/scripts/set-webhook.sh
PORT=3001
HOST=0.0.0.0

# ── Evolution API (mesma instancia configurada em infra/evolution/.env) ──
EVOLUTION_API_URL=https://evolution.daylanches.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=daylanches

# ── Worker Cloudflare (para consultar status de pedido) ──
WORKER_URL=https://day-lanches-worker.limaribeiroabraaolimaribeiro.workers.dev

# Mesmo valor configurado como PRINT_AGENT_TOKEN no Worker
# (wrangler secret put PRINT_AGENT_TOKEN) — reaproveita o token existente,
# nao e um secret novo.
DAYLANCHES_AGENT_TOKEN=

# ── Robo de atendimento ──
BOT_ENABLED=true
BOT_BUSINESS_HOURS=Quarta a domingo, das 17h30 as 23h
BOT_MENU_EXPIRE_HOURS=12
BOT_HANDOFF_PAUSE_HOURS=4

# Caminho do arquivo de sessoes de conversa (por telefone). Mantenha fora do
# git — sobrevive a restart do PM2 pois fica em disco na VPS.
SESSIONS_FILE=./data/bot-sessions.json
